{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect.sh", "timeout": 300 }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./config/*.secret.exs)",
      "Edit(./.env)", "Edit(./.env.*)", "Edit(./config/*.secret.exs)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(mix ecto.reset*)"
    ]
  }
}
