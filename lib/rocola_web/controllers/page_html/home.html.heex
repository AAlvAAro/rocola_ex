<Layouts.flash_group flash={@flash} />

<header class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
  <a href="/" class="flex items-center gap-2 text-lg font-bold">
    <.icon name="hero-musical-note" class="size-6 text-primary" /> Rocola
  </a>
  <Layouts.theme_toggle />
</header>

<main class="mx-auto max-w-5xl px-4 sm:px-6">
  <section class="py-16 text-center sm:py-24">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
      The jukebox for your <span class="whitespace-nowrap">get-togethers</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-base-content/70">
      Guests scan a QR code, search Spotify and add songs to the queue.
      Rocola runs on a Raspberry Pi and plays through the speaker you already have.
    </p>
    <a href="#how-it-works" class="btn btn-primary btn-lg mt-8">How it works</a>
  </section>

  <section id="how-it-works" class="py-12">
    <h2 class="text-center text-2xl font-bold sm:text-3xl">How it works</h2>
    <ol class="mt-10 grid gap-6 sm:grid-cols-3">
      <li class="card bg-base-200">
        <div class="card-body">
          <.icon name="hero-qr-code" class="size-8 text-primary" />
          <h3 class="card-title">1. Scan the QR</h3>
          <p class="text-base-content/70">No app or account needed. Just the phone camera.</p>
        </div>
      </li>
      <li class="card bg-base-200">
        <div class="card-body">
          <.icon name="hero-magnifying-glass" class="size-8 text-primary" />
          <h3 class="card-title">2. Search a song</h3>
          <p class="text-base-content/70">Find any track in the Spotify catalog.</p>
        </div>
      </li>
      <li class="card bg-base-200">
        <div class="card-body">
          <.icon name="hero-queue-list" class="size-8 text-primary" />
          <h3 class="card-title">3. It joins the queue</h3>
          <p class="text-base-content/70">
            Plays on your Sonos, phone or smart speaker.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="py-12">
    <div class="card bg-base-200">
      <div class="card-body">
        <h2 class="card-title text-xl">House rules</h2>
        <ul class="list-disc space-y-1 pl-5 text-base-content/70">
          <li>Up to 3 songs per guest every 30 minutes, so everyone gets a turn.</li>
          <li>A song that's already in the queue can't be requested again.</li>
        </ul>
      </div>
    </div>
  </section>
</main>

<footer class="mx-auto max-w-5xl px-4 py-10 text-center text-sm text-base-content/60 sm:px-6">
  A personal, non-commercial project. Not affiliated with or endorsed by Spotify.
</footer>
