<div class="tape-world min-h-screen bg-tape-shell font-tape-display text-tape-label">
  <Layouts.flash_group flash={@flash} />

  <header class="mx-auto flex max-w-6xl items-baseline justify-between gap-4 px-4 pb-6 pt-8 sm:px-6">
    <a href="/" class="tape-wide text-2xl font-black uppercase tracking-tight sm:text-3xl">
      Rocola
    </a>
    <p class="font-tape-type text-sm text-tape-shell-ink">a home jukebox</p>
  </header>

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <%!-- The J-card, unfolded: spine + front panel + back flap (Side B) --%>
    <section
      aria-labelledby="hero-title"
      class="flex overflow-hidden rounded-md bg-tape-card text-tape-ink shadow-[0_24px_48px_-12px_rgb(10_20_80/0.55)]"
    >
      <%!-- Spine --%>
      <div class="flex w-9 shrink-0 items-start justify-center border-r border-dashed border-tape-ink/40 pt-8 md:w-16">
        <p class="font-tape-type text-xs uppercase tracking-[0.2em] [writing-mode:vertical-rl] rotate-180 md:text-sm">
          Rocola · Tonight's mix · C-90
        </p>
      </div>

      <div class="@container min-w-0 flex-1">
        <%!-- Front panel --%>
        <h1
          id="hero-title"
          class="tape-wide px-4 pb-6 pt-8 text-[2.25rem] font-black uppercase leading-[0.92] tracking-tight [text-wrap:balance] sm:px-8 sm:text-[clamp(2.25rem,7.8cqi,5.5rem)]"
        >
          The jukebox for your <span class="sm:whitespace-nowrap">get-togethers</span>
        </h1>

        <div class="tape-stripes h-6" aria-hidden="true"></div>

        <%!-- Tracklist label --%>
        <div class="px-3 py-8 sm:px-8">
          <figure class="rounded-sm bg-tape-label shadow-[0_6px_16px_-6px_rgb(20_20_20/0.45)]">
            <figcaption class="flex items-center justify-between gap-4 border-b-2 border-tape-ink px-4 py-3 sm:px-5">
              <span class="font-tape-type text-base uppercase tracking-[0.15em]">Side A</span>
              <%!-- Cassette window: one spool full, one nearly empty --%>
              <span
                class="flex items-center gap-5 rounded-full bg-tape-ink px-3 py-1.5"
                aria-hidden="true"
              >
                <span class="flex size-7 items-center justify-center rounded-full border-[5px] border-tape-card-ink">
                  <span class="block size-4 animate-tape-spin rounded-full border-[3px] border-dashed border-tape-label"></span>
                </span>
                <span class="flex size-7 items-center justify-center rounded-full">
                  <span class="block size-4 animate-tape-spin rounded-full border-[3px] border-dashed border-tape-label"></span>
                </span>
              </span>
            </figcaption>
            <ol class="tape-ruled px-4 pb-2 pt-1 font-tape-hand text-lg sm:px-5 sm:text-2xl">
              <li
                :for={
                  {{song, guest}, i} <-
                    Enum.with_index([
                      {"an 80s classic", "Luis"},
                      {"one to dance to", "Mar"},
                      {"the sing-along", "Diego"}
                    ])
                }
                class="flex h-12 items-center gap-3 sm:gap-4"
              >
                <span class="w-4 shrink-0 font-tape-type text-sm text-tape-ink/70 sm:w-6">{i + 1}</span>
                <span class="flex min-w-0 flex-1 items-baseline justify-between gap-3">
                  <span class="truncate">{song}</span>
                  <span class="shrink-0">~ {guest}</span>
                </span>
              </li>
              <li class="flex h-12 items-center gap-3 sm:gap-4">
                <span class="w-4 shrink-0 font-tape-type text-sm text-tape-ink/70 sm:w-6">4</span>
                <span class="flex flex-1 items-baseline justify-end gap-1">
                  ~ you?<span
                    class="inline-block h-6 w-0.5 animate-tape-caret bg-tape-ink"
                    aria-hidden="true"
                  ></span>
                </span>
              </li>
            </ol>
            <p class="px-4 pb-3 text-right font-tape-type text-xs text-tape-ink/70 sm:px-5">
              sample tracklist
            </p>
          </figure>
        </div>

        <%!-- Bottom band: sub + action --%>
        <div class="flex flex-col gap-6 px-4 pb-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <p class="max-w-xl text-lg leading-snug">
            Guests scan a QR code, search Spotify and add songs to the queue.
            Rocola runs on a Raspberry Pi and plays through the speaker you already have,
            using your own Spotify Premium account.
          </p>
          <a
            href="#side-b"
            class="tape-key inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-sm px-6 font-bold uppercase tracking-wide"
          >
            <.icon name="hero-play-solid" class="size-5" /> Play side B
          </a>
        </div>

        <%!-- Fold, then the back flap --%>
        <section
          id="side-b"
          aria-labelledby="side-b-title"
          class="scroll-mt-6 border-t-2 border-dashed border-tape-ink/50 px-3 pb-8 pt-10 sm:px-8"
        >
          <h2
            id="side-b-title"
            class="tape-wide px-1 text-3xl font-black uppercase tracking-tight sm:px-0 sm:text-5xl"
          >
            Side B: how it works
          </h2>
          <ol class="mt-6 divide-y divide-tape-rule rounded-sm bg-tape-label shadow-[0_6px_16px_-6px_rgb(20_20_20/0.45)]">
            <li
              :for={
                {code, title, body} <- [
                  {"B1", "Scan the QR", "No app or account needed. Just the phone camera."},
                  {"B2", "Search a song", "Find any track in the Spotify catalog."},
                  {"B3", "It joins the queue", "Plays on your Sonos, phone or smart speaker."}
                ]
              }
              class="px-4 py-6 sm:grid sm:grid-cols-[4rem_1fr] sm:items-baseline sm:px-8"
            >
              <span class="hidden font-tape-type text-lg text-tape-card-ink sm:block">{code}</span>
              <div>
                <h3 class="text-2xl font-extrabold">
                  <span class="mr-2 font-tape-type text-lg font-normal text-tape-card-ink sm:hidden">
                    {code}
                  </span>{title}
                </h3>
                <p class="mt-1 text-lg text-tape-ink/75">{body}</p>
              </div>
            </li>
          </ol>
        </section>
      </div>
    </section>

    <%!-- Liner notes --%>
    <section aria-labelledby="rules-title" class="py-20">
      <div class="rounded-sm bg-tape-card px-5 py-8 text-tape-ink sm:px-8">
        <h2
          id="rules-title"
          class="tape-wide text-3xl font-black uppercase tracking-tight sm:text-5xl"
        >
          House rules
        </h2>
        <ul class="mt-6 space-y-3 font-tape-type text-lg leading-relaxed">
          <li>Up to 3 songs per guest every 30 minutes, so everyone gets a turn.</li>
          <li>A song that's already in the queue can't be requested again.</li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-6xl px-4 pb-10 font-tape-type text-sm text-tape-shell-ink sm:px-6">
    A personal, non-commercial project. Not affiliated with or endorsed by Spotify.
  </footer>
</div>
