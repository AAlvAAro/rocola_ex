+defmodule RocolaWeb.AdminLive do
+  use RocolaWeb, :live_view
+
+  @impl true
+  def mount(_params, _session, socket), do: {:ok, load(socket)}
+
+  @impl true
+  def handle_event("refresh", _, socket), do: {:noreply, load(socket)}
+
+  def handle_event("select", %{"id" => id}, socket) do
+    # Rule 6: restricted devices never get commands (checked here, not just in the UI).
+    with %{is_restricted: false} <- Enum.find(socket.assigns.devices, &(&1.id == id)),
+         :ok <- Rocola.Spotify.transfer_playback(id) do
+      {:noreply, load(socket)}
+    else
+      _ -> {:noreply, put_flash(socket, :error, "Device unavailable")}
+    end
+  end
+
+  defp load(socket) do
+    case Rocola.Spotify.devices() do
+      {:ok, devices} -> assign(socket, devices: devices, error: nil)
+      {:error, _} -> assign(socket, devices: [], error: "Could not load devices")
+    end
+  end
+
+  @impl true
+  def render(assigns) do
+    ~H"""
+    <Layouts.flash_group flash={@flash} />
+    <div class="mx-auto max-w-xl p-6">
+      <div class="flex items-center justify-between mb-4">
+        <h1 class="text-xl font-bold">Playback devices</h1>
+        <button id="refresh" phx-click="refresh" class="btn btn-sm">Refresh</button>
+      </div>
+      <p :if={@error} class="text-error">{@error}</p>
+      <p :if={@devices == [] and !@error}>No devices found. Wake one up and refresh.</p>
+      <ul class="space-y-2">
+        <li
+          :for={d <- @devices}
+          id={"device-#{d.id}"}
+          class="flex items-center justify-between rounded border p-3"
+        >
+          <span class={d.is_restricted && "opacity-50"}>
+            {d.name}
+            <span :if={d.is_active} class="badge badge-success ml-2">Active</span>
+            <span :if={d.is_restricted} class="badge ml-2">Unavailable</span>
+          </span>
+          <button
+            :if={!d.is_restricted}
+            phx-click="select"
+            phx-value-id={d.id}
+            disabled={d.is_active}
+            class="btn btn-sm btn-primary"
+          >
+            Select
+          </button>
+        </li>
+      </ul>
+    </div>
+    """
+  end
+end
